{
  "manifest_version": 3,
  "name": "Sirenproof",
  "version": "0.1.0",
  "description": "Blocks the pages you chose, on your own rules. Works with the Sirenproof app for Windows; nothing leaves your PC.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "tabs"],
  "background": { "service_worker": "background.js" }
}
